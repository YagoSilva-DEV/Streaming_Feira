<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style TargetType="TextBlock" x:Key="StyleTextBlockLogoLogin">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="Heavy"/>
        <Setter Property="Foreground" Value="{StaticResource TextBlockLogoLogin}"/>
        <Setter Property="FontSize" Value="40"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="StyleTextBlockLogin">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryLoginBrush}"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>
</ResourceDictionary>