<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="ButtonGradientLogin" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource PrimaryPurpleLogin}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryBlueLogin}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TextBlockLogoLogin" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource TextPrimaryLogin}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryPurpleLogin}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonGradientSignUp" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="DodgerBlue" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryBlueLogin}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>