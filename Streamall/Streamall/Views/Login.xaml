<Window x:Class="Streamall.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Streamall.Views"
        xmlns:hepers="clr-namespace:Streamall.Helpers"
        xmlns:userControls="clr-namespace:Streamall.Views.UserControls"
        xmlns:viewModels="clr-namespace:Streamall.ViewModels"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        BorderBrush="White"
        BorderThickness="1"
        Background="{StaticResource BackgroundColorLoginBrush}"
        Title="Login" Height="400" Width="600"
        >
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:LoginControlViewModel}">
            <userControls:LoginControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ErrorControlViewModel}">
            <userControls:ErrorControl/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
