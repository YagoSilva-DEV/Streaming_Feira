<Window x:Class="Streamall.Views.Home"
        xmlns:vm="clr-namespace:Streamall.ViewModels"
        xmlns:views="clr-namespace:Streamall.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Streamall.Views"
        xmlns:userControls="clr-namespace:Streamall.Views.UserControls"
        mc:Ignorable="d"
        Title="Home" Height="1080" Width="1920">

    <Window.Resources>
<!-- caminhos/views que são frames, irao aparecer ao click de cada button respectivamente-->
    <!--tela default-->
        <DataTemplate DataType="{x:Type vm:StartViewModel}">
            <views:Start/>
        </DataTemplate>
    <!--tela default-->

        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:Pesquisa/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FavoritesViewModel}">
            <views:Favorites/>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <userControls:Header Grid.Row="0"/>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <userControls:SideBar Grid.Column="0" />

            <!--frame sera "caixa" que contera as views aparti do click-->
            <userControls:Carousel Grid.Column="1"/>
            <Frame Grid.Column="1" Background="{StaticResource BackgroundColorLoginBrush}" NavigationUIVisibility="Hidden" Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>
