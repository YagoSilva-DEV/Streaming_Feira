<Window x:Class="Streamall.Views.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Streamall.Views"
        xmlns:userControls="clr-namespace:Streamall.Views.UserControls"
        mc:Ignorable="d"
        Title="CINEVERSE"
        Height="1080"
        Width="1920"
        Background="#0A0E17">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <userControls:Header Grid.Row="0"/>


        <!-- CONTEÚDO -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- SIDEBAR -->

            <userControls:SideBar Grid.Column="0"/>


            <userControls:Carousel Grid.Column="1" />
        </Grid>

    </Grid>

</Window>