<Window x:Class="Streamall.Views.Home"
        xmlns:vm="clr-namespace:Streamall.ViewModels"
        xmlns:vmc="clr-namespace:Streamall.ViewModels.Contents"
        xmlns:views="clr-namespace:Streamall.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Streamall.Views"
        xmlns:userControls="clr-namespace:Streamall.Views.UserControls"
        mc:Ignorable="d"
        Title="Home" Height="550" Width="850"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Background="{StaticResource BackgroundColorLoginBrush}"
        WindowState="Maximized"
        WindowStyle="None">

    <Window.Resources>
        <!-- DataTemplates existentes -->
        <DataTemplate DataType="{x:Type vm:StartViewModel}">
            <views:Start/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:Pesquisa/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FavoritesViewModel}">
            <views:Favorites/>
        </DataTemplate>

        <!-- ESTILOS DOS BOTÕES DA JANELA -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#222634"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2D3245"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo do botão fechar -->
        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BF1020"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- TitleBar Compacta -->
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO DA JANELA (HEADER) -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceColorLoginBrush}" 
                BorderBrush="#1AFFFFFF" 
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Área do Logo (Alinhada com a largura da Sidebar) -->
                <TextBlock Grid.Column="0" 
                           Grid.ColumnSpan="2"
                           Text="STREAMALL" 
                           Style="{StaticResource StyleTextBlockLogoLogin}" 
                           FontWeight="Bold" 
                           FontSize="18"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"/>

                <!-- Controles de Janela -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <!-- MINIMIZAR -->
                    <Button Style="{StaticResource WindowControlButtonStyle}" 
                            x:Name="btnMinimize"
                            Click="btnMinimize_Click"
                            ToolTip="Minimizar">
                        <Path Data="M 0,5 H 10 V 6 H 0 Z" 
                              Fill="#A0A5B5" 
                              Stretch="Uniform" 
                              Width="10" Height="10"/>
                    </Button>

                    <!-- MAXIMIZAR / RESTAURAR -->
                    <Button Style="{StaticResource WindowControlButtonStyle}" 
                            x:Name="btnMaximize"
                            Click="btnMaximize_Click" 
                            ToolTip="Maximizar / Restaurar">
                        <Path Data="M 0,0 H 9 V 9 H 0 Z M 1,1 V 8 H 8 V 1 Z" 
                              Fill="#A0A5B5" 
                              Stretch="Uniform" 
                              Width="9" Height="9"/>
                    </Button>

                    <!-- FECHAR -->
                    <Button Style="{StaticResource WindowCloseButtonStyle}" 
                            ToolTip="Fechar"
                            Command="{Binding ExitCommand}">
                        <Path Data="M 0.7,0 L 0,0.7 L 4.3,5 L 0,9.3 L 0.7,10 L 5,5.7 L 9.3,10 L 10,9.3 L 5.7,5 L 10,0.7 L 9.3,0 L 5,4.3 Z" 
                              Fill="#A0A5B5" 
                              Stretch="Uniform" 
                              Width="10" Height="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTEÚDO PRINCIPAL (SIDEBAR + FRAME) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR BARRA LATERAL -->
            <Border Grid.Column="0" 
                    Background="{StaticResource SurfaceColorLoginBrush}" 
                    BorderBrush="#1AFFFFFF" 
                    BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <!-- Agrupamento de Botões Superiores -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                        <Button Style="{StaticResource StyleButtonSideBar}" 
                                Command="{Binding HomeCommand}"
                                Margin="0,4"
                                ToolTip="Início">
                            <Path Style="{StaticResource IconsGlobalConfigs}" Data="{StaticResource IconHome}"/>
                        </Button>

                        <Button Style="{StaticResource StyleButtonSideBar}" 
                                Command="{Binding SearchCommand}"
                                Margin="0,4"
                                ToolTip="Pesquisar">
                            <Path Style="{StaticResource IconsGlobalConfigs}" Data="{StaticResource IconSearch}"/>
                        </Button>

                        <Button Style="{StaticResource StyleButtonSideBar}" 
                                Command="{Binding FavoritesCommand}"
                                Margin="0,4"
                                ToolTip="Favoritos">
                            <Path Style="{StaticResource IconsGlobalConfigs}" Data="{StaticResource IconStar}"/>
                        </Button>
                    </StackPanel>

                    <!-- Botão de Sair Fixo no Rodapé -->
                    <Button DockPanel.Dock="Bottom" 
                            Style="{StaticResource StyleButtonSideBar}" 
                            Command="{Binding ExitCommand}"
                            Margin="0,0,0,12"
                            ToolTip="Sair">
                        <Path Style="{StaticResource IconsGlobalConfigs}" Data="{StaticResource IconExit}"/>
                    </Button>
                </DockPanel>
            </Border>

            <!-- FRAME PRINCIPAL DE CONTEÚDO -->
            <Frame Grid.Column="1" 
                   NavigationUIVisibility="Hidden" 
                   Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>