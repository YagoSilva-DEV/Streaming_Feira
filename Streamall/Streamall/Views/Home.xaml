<Window x:Class="Streamall.Views.Home"
        xmlns:vm="clr-namespace:Streamall.ViewModels"
        xmlns:vmc="clr-namespace:Streamall.ViewModels.Contents"
        xmlns:views="clr-namespace:Streamall.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Streamall.Views"
        xmlns:userControls="clr-namespace:Streamall.Views.UserControls"
        mc:Ignorable="d"
        Title="Home" Height="1080" Width="1920"
        Background="{StaticResource BackgroundColorLoginBrush}"
        WindowState="Maximized">
        

    <Window.Resources>
<!-- caminhos/views que são frames, irao aparecer ao click de cada button respectivamente-->
    <!--tela default-->
        <DataTemplate DataType="{x:Type vm:StartViewModel}">
            <views:Start/>
        </DataTemplate>
    <!--tela default-->

        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:Pesquisa/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FavoritesViewModel}">
            <views:Favorites/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmc:ContentHeroViewModel}">
            <userControls:ContentHero/>
        </DataTemplate> 
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Background="{StaticResource SurfaceColorLoginBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!--<TextBox Grid.Column="0" Background="Transparent" Foreground="White" BorderThickness="0" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Center"> Nivel assinatura </TextBox>-->
            <TextBlock Grid.Column="1" Style="{StaticResource StyleTextBlockLogoLogin}" FontSize="60"  VerticalAlignment="Center" > STREAMALL</TextBlock>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <TextBlock  Foreground="White" Margin="5"  VerticalAlignment="Center"/>
                <TextBlock  Foreground="White" Margin="5"  VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Background="{StaticResource SurfaceColorLoginBrush}" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.1*"/>
                    <RowDefinition Height="0.1*"/>
                    <RowDefinition Height="0.1*"/>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="0.1*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"  Style="{StaticResource StyleButtonSideBar}"  Command="{Binding HomeCommand}">
                    <Path 
                Style="{StaticResource IconsGlobalConfigs}"
                Data="{StaticResource IconHome}"
            />
                </Button>

                <Button Grid.Row="1" Style="{StaticResource StyleButtonSideBar}" Command="{Binding SearchCommand}">
                    <Path 
                Style="{StaticResource IconsGlobalConfigs}"
                Data="{StaticResource IconSearch}"
            />
                </Button>

                <Button Grid.Row="2" Style="{StaticResource StyleButtonSideBar}"  Command="{Binding FavoritesCommand}">
                    <Path 
                Style="{StaticResource IconsGlobalConfigs}"
                Data="{StaticResource IconStar}"
             />
                </Button>

                <!-- ENGRENAGEM INICIO-->

   
                    <!-- ENGRENAGEM FIM-->

                <Button  Grid.Row="6" Style="{StaticResource StyleButtonSideBar}" Command="{Binding ExitCommand}">
                    <Path
                Style="{StaticResource IconsGlobalConfigs}"
                Data="{StaticResource IconExit}"
            />
                </Button>


            </Grid>

            <!--frame sera "caixa" que contera as views aparti do click-->
            <Frame Grid.Column="1" NavigationUIVisibility="Hidden" Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>
