<Page x:Class="Streamall.Views.Favorites"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Streamall.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Favorites">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="Favoritos" FontSize="30" Foreground="White" Margin="20,10,0,0"/>
                <TextBlock Text="Seus filmes e séries favoritos em um só lugar para assistir" Foreground="White" Margin="30,10,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Total de favoritos" Foreground="White" Margin="0,20,20,0" />
                    <TextBlock Text="{Binding Favourites.Count}" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
                <Border Height="30" BorderBrush="White" Margin="0,10,20,0"/>

                <ComboBox  >
                    <ComboBoxItem Content="Mais recentes" IsSelected="True"/>
                    <ComboBoxItem Content="Mais antigos"/>
                    <ComboBoxItem Content="A → Z"/>
                    <ComboBoxItem Content="Z → A"/>
                </ComboBox>
            </StackPanel>
            
        </Grid>
        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Favorites}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="180"
                        Margin="10"
                        Padding="10"
                        Background="{StaticResource BackgroundColorLoginBrush}">
                            <StackPanel>
                                <Image Source="{Binding PathCover}"
                               Width="150"
                               Height="210"
                               Stretch="Uniform"/>

                                <TextBlock Text="{Binding Name}"
                                   Foreground="White"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
