<Page x:Class="Streamall.Views.Favorites"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Streamall.Views"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Favorites">

    <Page.Resources>
        <!-- Estilo do Botão de Remover (Lixeira Flutuante) -->
        <Style x:Key="StyleRemoveFavoriteButton" TargetType="Button">
            <Setter Property="Background" Value="#B3111827"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO DA PÁGINA -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Título e Subtítulo -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Favoritos" FontSize="32" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Seus filmes favoritados em um só lugar" Foreground="#9CA3AF" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Painel de Informações e Ordenação -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Contador de Favoritos -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Total de favoritos" Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Favorites.Count}" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Divisor -->
                <Border Width="1" Height="28" Background="#374151" Margin="0,0,20,0"/>

                <!-- Combo de Filtro/Ordenação -->
            </StackPanel>
        </Grid>

        <!-- LISTA DE CARDS DE FAVORITOS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="30">
            <ItemsControl ItemsSource="{Binding Favorites}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Container Principal com ToolTip no Card Todo -->
                        <Border Width="220" 
                                Margin="0,0,20,24" 
                                Background="Transparent"
                                ToolTip="{Binding Name}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="CardShadow" BlurRadius="12" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.35"/>
                            </Border.Effect>

                            <!-- Button Usado Apenas para Renderizar o Card com Triggers de Hover -->
                            <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                                    Focusable="False"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <!-- Card Principal -->
                                        <Border x:Name="CardBorder"
                                                CornerRadius="12" 
                                                Background="#1E2330" 
                                                BorderThickness="1" 
                                                BorderBrush="#2A2F3D"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Área da Imagem -->
                                                <Grid Grid.Row="0">
                                                    <Rectangle Width="218" Height="320">
                                                        <Rectangle.Fill>
                                                            <ImageBrush ImageSource="{Binding PathCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Rectangle.Fill>
                                                    </Rectangle>

                                                    <!-- Botão Remover dos Favoritos -->
                                                    <Button Style="{StaticResource StyleRemoveFavoriteButton}"
                                                            Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="10"
                                                            ToolTip="Remover dos favoritos">
                                                        <Path Data="M 3 6 H 17 M 8 6 V 4 C 8 3.4 8.4 3 9 3 H 11 C 11.6 3 12 3.4 12 4 V 6 M 5 6 V 16 C 5 16.6 5.4 17 6 17 H 14 C 14.6 17 15 16.6 15 16 V 6 M 8 9 V 14 M 12 9 V 14" 
                                                              Stroke="White" 
                                                              StrokeThickness="1.8" 
                                                              Stretch="Uniform" 
                                                              Width="15" 
                                                              Height="15"/>
                                                    </Button>
                                                </Grid>

                                                <!-- Título do Filme / Série -->
                                                <Border Grid.Row="1" Padding="14,12" Background="#181D28" CornerRadius="0,0,12,12">
                                                    <TextBlock x:Name="CardTitle"
                                                               Text="{Binding Name}" 
                                                               Foreground="White" 
                                                               FontSize="15" 
                                                               FontWeight="SemiBold" 
                                                               TextWrapping="NoWrap" 
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Triggers de Hover e Animações -->
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#6366F1"/>
                                                <Setter TargetName="CardTitle" Property="Foreground" Value="#818CF8"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>