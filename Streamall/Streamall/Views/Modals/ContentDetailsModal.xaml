<Window x:Class="Streamall.Views.Modals.ContentDetailsModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:Streamall.Views.UserControls"
        Title="Detalhes do filme"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        BorderBrush="White"
        BorderThickness="1"
        Background="{StaticResource SurfaceColorLoginBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Cabeçalho com Titulo e Botão Fechar -->
            <RowDefinition Height="Auto"/>
            <!-- Área Hero (Capa, Detalhes e Ações) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,15">
            <TextBlock Text="Detalhes do Filme"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button Content="Fechar"
                    Width="90"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#30333A"
                                CornerRadius="10"
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="White"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- SEÇÃO HERO (CONTEÚDO PRINCIPAL) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Capa/Poster com Proporção Mantida -->
                <ColumnDefinition Width="5*"/>
                <!-- Informações e Botões -->
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <!-- Capa do Filme -->
            <Border  
                Style="{StaticResource CardBorderStyle}"
                Background="{StaticResource BackgroundColorLoginBrush}" 
                BorderBrush="{StaticResource BorderColorLoginBrush}" 
                BorderThickness="1" Margin="15"
             >
                <Image Source="{Binding ContentDTO.PathCover}" Stretch="UniformToFill"/>
            </Border>

            <!-- Detalhes do Filme -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Título -->
                <TextBlock Text="{Binding ContentDTO.Name, FallbackValue='Título do Filme'}" 
                           FontSize="28" 
                           Foreground="White" 
                           FontWeight="Bold" 
                           TextWrapping="Wrap"/>

                <!-- Metadados (Ano • Gênero • Cineasta/Duração) -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{Binding ContentDTO.ReleaseDate.Year, FallbackValue='Ano'}" Foreground="#CCCCCC" FontSize="14"/>
                    <TextBlock Text="•" Foreground="#CCCCCC" Margin="10,0" FontSize="14"/>
                    <TextBlock Text="{Binding ContentDTO.Genre, FallbackValue='Gênero'}" Foreground="#CCCCCC" FontSize="14"/>
                    <TextBlock Text="•" Foreground="#CCCCCC" Margin="10,0" FontSize="14"/>
                    <TextBlock Text="{Binding ContentDTO.FilmMaker, FallbackValue='Diretor'}" Foreground="#CCCCCC" FontSize="14"/>
                </StackPanel>

                <!-- Sinopse com ScrollViewer -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180" Margin="0,15,0,0">
                    <TextBlock Text="{Binding ContentDTO.Synopsis, FallbackValue='Sinopse do filme...'}"
                               TextWrapping="Wrap"
                               FontSize="14" 
                               Foreground="White" 
                               LineHeight="20"/>
                </ScrollViewer>

                <!-- Botões de Ação -->
                <StackPanel Orientation="Vertical" Margin="0,20,0,0">
                    <!-- Botão Assistir -->
                    <!-- ToggleButton de Favoritos -->
                    <ToggleButton x:Name="FavoriteToggle"
                                  Width="130"
                                  Height="38"
                                  Cursor="Hand"
                                  ToolTip="Adicionar ou remover dos favoritos"
                                  Command="{Binding AddFavoriteCommand}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Circle"
                                        CornerRadius="6"
                                        Background="#30333A"
                                        BorderBrush="#666666"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="StarIcon"
                                                   Text="☆"
                                                   FontFamily="Segoe UI Symbol"
                                                   FontSize="18"
                                                   Foreground="White"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Favoritos" 
                                                   VerticalAlignment="Center" 
                                                   Foreground="White"
                                                   FontSize="14"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Circle" Property="Background" Value="#454A54"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="StarIcon" Property="Text" Value="★"/>
                                        <Setter TargetName="StarIcon" Property="Foreground" Value="#FFD700"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>

                    </ToggleButton>
                    <Grid Margin="10">
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource StyleTextBlockError}"/>
                        <TextBlock Text="{Binding SuccessMessage}" Style="{StaticResource StyleTextBlockSuccess}"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>



    </Grid>
</Window>