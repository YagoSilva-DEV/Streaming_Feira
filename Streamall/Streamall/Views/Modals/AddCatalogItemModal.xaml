<Window x:Class="Streamall.Views.Modals.AddCatalogItemModal"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:local="clr-namespace:Streamall.Views.Modals"
       xmlns:ViewModels="clr-namespace:Streamall.ViewModels.Contents"
       xmlns:UserControl="clr-namespace:Streamall.Views.UserControls"
       mc:Ignorable="d"
       WindowStyle="None"
       BorderBrush="White"
       BorderThickness="1"
       Background="{StaticResource BackgroundColorLoginBrush}"
       MouseLeftButtonDown="Window_MouseLeftButtonDown"
       Title="EditContentModal"
       Width="420"
       MinWidth="300"
       Height="320">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="16">
            <Border Style="{StaticResource CardBorderStyle}"
                Padding="24"
                MaxWidth="520"
                HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="STREAMALL STUDIO"
                           Foreground="{StaticResource TextSecondaryLoginBrush}"
                           FontSize="12"
                           FontFamily="{StaticResource Righteous}"
                           FontWeight="Bold"/>

                    <TextBlock Text="{Binding ToDo}"
                           Foreground="{StaticResource TextPrimaryLoginBrush}"
                           FontSize="21"
                           FontFamily="{StaticResource Righteous}"
                           FontWeight="Bold"
                           Margin="0,6,0,4"/>

                    <TextBlock Text="{Binding Description}"
                           Foreground="{StaticResource TextSecondaryLoginBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,22"/>

                    <TextBlock Text="{Binding FieldLabel}"
                           Style="{StaticResource StyleFieldLabelEditModal}"
                           Margin="0,0,0,6"/>

                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource StyleTextBoxEditModal}"
                         Height="42"
                         MaxLength="100"/>
                    <Grid>
                    <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource StyleTextBlockError}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding SuccessMessage}"
                           Style="{StaticResource StyleTextBlockSuccess}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
                    </Grid>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                            Content="CANCELAR"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource StyleSecondaryButtonEditModal}"
                            Height="42"/>

                        <Button Grid.Column="2"
                            Content="SALVAR"
                            Command="{Binding AddItemCommand}"
                            Style="{StaticResource StylePrimaryButtonEditModal}"
                            Height="42"/>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
