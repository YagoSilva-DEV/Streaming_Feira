<Window x:Class="Streamall.Views.Modals.EditContentModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Streamall.Views.Modals"
        mc:Ignorable="d"
        WindowStyle="None"
        BorderBrush="White"
        BorderThickness="1"
        Background="{StaticResource BackgroundColorLoginBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="EditContentModal" Height="700" Width="550">
    <Window.Resources>
        <!-- Cores do Tema -->
        <SolidColorBrush x:Key="SurfaceBackground" Color="#16171D"/>
        <SolidColorBrush x:Key="InputBackground" Color="#1F2029"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2A2B36"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8F92A1"/>

        <!-- Roxo Escuro / Sóbrio -->
        <SolidColorBrush x:Key="PurpleDark" Color="#3B2D54"/>
        <SolidColorBrush x:Key="PurpleHover" Color="#4F3B6E"/>
        <SolidColorBrush x:Key="PurpleBorder" Color="#5C4582"/>

        <!-- Estilo dos Rótulos (Labels) -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Estilo dos Inputs de Texto -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PurpleBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Botão Primário (Roxo Escuro) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PurpleDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{StaticResource PurpleBorder}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PurpleHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Secundário -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#252631"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#303240"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecalho Organizado -->
        <Border Grid.Row="0" Margin="0,0,0,24" Padding="0,0,0,16" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="STREAMALL STUDIO" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Editar Conteúdo" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="ID:" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource InputBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                        <TextBlock Text="{Binding ContentDTO.Id}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Formulario em Painel Organizado -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Coluna Esquerda: Capa e Arquivo -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Capa do Conteúdo" Style="{StaticResource FieldLabel}"/>

                <Border Height="340" Background="{StaticResource InputBackground}" CornerRadius="6" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,12">
                    <Grid>
                        <Image Source="{Binding ContentDTO.PathCover}" Stretch="UniformToFill"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Nenhum arquivo" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Campo do Caminho da Capa -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding CoverPath}" Height="38" x:Name="txtCoverPath"/>
                    <Button Grid.Column="1" Content="Buscar" Width="70" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding SelectCoverCommand}"/>
                </Grid>
            </StackPanel>

            <!-- Coluna Direita: Campos de Dados -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Linha 1: Nome do Conteúdo -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Nome do Conteúdo" Style="{StaticResource FieldLabel}"/>
                    <TextBox Height="40" Text="{Binding NameContent}"/>
                </StackPanel>

                <!-- Linha 2: Tipo, Gênero e Lançamento -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}"/>
                        <ComboBox SelectedValue="{Binding TypeContent}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Filme" Tag="1"/>
                            <ComboBoxItem Content="Série" Tag="2"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Gênero" Style="{StaticResource FieldLabel}"/>
                        <ComboBox SelectedValue="{Binding GenderId}" ItemsSource="{Binding GenresList}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Ano / Lançamento" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding ReleaseDate}" Height="40" Background="{StaticResource InputBackground}"/>
                    </StackPanel>
                </Grid>

                <!-- Linha 3: Cineasta / Diretor -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock Text="Cineasta / Diretor" Style="{StaticResource FieldLabel}"/>
                    <ComboBox SelectedValue="{Binding FilmmakerId}" ItemsSource="{Binding FilmmakersList}"/>
                </StackPanel>

                <!-- Linha 4: Sinopse -->
                <StackPanel Grid.Row="3">
                    <TextBlock Text="Sinopse" Style="{StaticResource FieldLabel}"/>
                    <TextBox Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding SynopsisContent}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Rodapé de Ações -->
        <Border Grid.Row="2" Margin="0,24,0,0" Padding="0,16,0,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Width="100" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Command="{Binding CloseWindowCommand}"/>
                    <Button Content="Salvar Alterações" Width="150" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
