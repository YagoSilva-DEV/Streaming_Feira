<Window x:Class="Streamall.Views.Modals.EditContentModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Streamall.Views.Modals"
        xmlns:ViewModels="clr-namespace:Streamall.ViewModels.Contents"
        xmlns:UserControl="clr-namespace:Streamall.Views.UserControls"
        mc:Ignorable="d"
        WindowStyle="None"
        BorderBrush="White"
        BorderThickness="1"
        Background="{StaticResource BackgroundColorLoginBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="EditContentModal" Height="700" Width="750">
    <Window.Resources>
        <DataTemplate DataType="{x:Type ViewModels:EditContentControlViewModel}">
            <UserControl:EditContent/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:ConfirmEditContentViewModel}">
            <UserControl:ConfirmEditContent/>
        </DataTemplate>
    </Window.Resources>
    
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ContentControl Content="{Binding CurrentViewModel}"/>

        <!-- Rodapé de Ações -->
        <Border Grid.Row="2" Margin="0,24,0,0" Padding="0,16,0,0" BorderBrush="{StaticResource BorderColorEditModalBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryLoginBrush}" VerticalAlignment="Center" FontSize="12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Width="100" Style="{StaticResource StyleSecondaryButtonEditModal}" Margin="0,0,12,0" Command="{Binding CancelCommand}"/>
                    <Button Content="Salvar Alterações" Width="150" Style="{StaticResource StylePrimaryButtonEditModal}" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>