<Window x:Class="Streamall.Views.SignUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Streamall.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        BorderBrush="White"
        BorderThickness="1"
        Background="{StaticResource BackgroundColorLoginBrush}"
        Title="SignUp" Height="400" Width="380">
    <Grid Margin="10" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.4*"/>
            <RowDefinition Height="8.6*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="STREAMALL" Style="{StaticResource StyleTextBlockLogoLogin}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="Cadastre-se para continuar" Style="{StaticResource StyleTextBlockLogin}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="7.53*"/>
                <RowDefinition Height="2.47*"/>
            </Grid.RowDefinitions>
            <Grid Margin="20,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.5*"/>
                    <RowDefinition Height="2.5*"/>
                    <RowDefinition Height="2.5*"/>
                    <RowDefinition Height="2.5*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="txtFullName" Style="{StaticResource StyleTextBoxLogin}" TextChanged="txtFullName_TextChanged"/>
                <TextBlock x:Name="tbFullName" Text="Nome completo" Style="{StaticResource StyleTextBlockLogin}" IsHitTestVisible="False"/>
                <TextBox Grid.Row="1" x:Name="txtUserName" Style="{StaticResource StyleTextBoxLogin}" TextChanged="txtUserName_TextChanged"/>
                <TextBlock x:Name="tbUserName" Grid.Row="1" Text="Nome de usuário" Style="{StaticResource StyleTextBlockLogin}" IsHitTestVisible="False"/>
                <TextBox Grid.Row="2" x:Name="txtEmail" Style="{StaticResource StyleTextBoxLogin}" TextChanged="txtEmail_TextChanged"/>
                <TextBlock x:Name="tbEmail" Grid.Row="2" Text="Email" Style="{StaticResource StyleTextBlockLogin}" IsHitTestVisible="False"/>
                <TextBox Grid.Row="3" x:Name="txtPassword" Style="{StaticResource StyleTextBoxLogin}" TextChanged="txtPassword_TextChanged"/>
                <TextBlock x:Name="tbPassword" Grid.Row="3" Text="Senha" Style="{StaticResource StyleTextBlockLogin}" IsHitTestVisible="False"/>
            </Grid>
            <Button Content="Cadastrar" Style="{StaticResource StylePrimaryButtonSignUp}" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
