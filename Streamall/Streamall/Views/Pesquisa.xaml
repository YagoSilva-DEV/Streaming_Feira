<Page x:Class="Streamall.Views.Pesquisa"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Streamall.Views"
      xmlns:userControls="clr-namespace:Streamall.Views.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Pesquisa">

    <Page.Resources>
        <!-- Paleta de Cores e Pincéis do Projeto -->
        <SolidColorBrush x:Key="BgCard" Color="#131622"/>
        <SolidColorBrush x:Key="BgHover" Color="#1C2132"/>
        <SolidColorBrush x:Key="BgSelected" Color="#252A3E"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#23283B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8C93A8"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="StatusActiveBg" Color="#102E26"/>
        <SolidColorBrush x:Key="StatusActiveFg" Color="#10B981"/>
        <SolidColorBrush x:Key="StatusInactiveBg" Color="#282026"/>
        <SolidColorBrush x:Key="StatusInactiveFg" Color="#EF4444"/>

        <!-- Fallbacks para os Brushes de Login -->
        <SolidColorBrush x:Key="BackgroundColorLoginBrush" Color="#131622"/>
        <SolidColorBrush x:Key="BorderColorLoginBrush" Color="#23283B"/>

        <!-- Estilo Customizado da Caixa de Busca -->
        <Style x:Key="ModernSearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="42,10,16,10"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentPurple}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="SearchBorder" 
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="20" 
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <!-- Ícone de Lupa -->
                                    <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                                          Fill="{StaticResource TextSecondary}" 
                                          Width="16" Height="16" 
                                          HorizontalAlignment="Left" 
                                          Margin="16,0,0,0" 
                                          Stretch="Uniform"/>

                                    <!-- Placeholder -->
                                    <TextBlock x:Name="PlaceholderText" 
                                               Text="Buscar por filmes..." 
                                               Foreground="{StaticResource TextSecondary}" 
                                               FontSize="14" 
                                               Margin="44,0,0,0" 
                                               VerticalAlignment="Center" 
                                               IsHitTestVisible="False" 
                                               Visibility="Collapsed"/>

                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                <Setter TargetName="SearchBorder" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do Botão do Card do Filme com Arredondamento Perfeito via OpacityMask -->
        <Style x:Key="NetflixCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="220" Height="330">
                            <!-- MÁSCARA DE RECORTE: Recorta tudo o que estiver dentro em 12px -->
                            <Grid.OpacityMask>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Border Width="220" Height="330" CornerRadius="12" Background="Black"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Grid.OpacityMask>

                            <!-- Card Container Principal -->
                            <Border x:Name="CardContainer"
                            Background="{StaticResource BackgroundColorLoginBrush}" 
                            BorderBrush="{StaticResource BorderColorLoginBrush}" 
                            BorderThickness="1" 
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                                <Grid>
                                    <!-- Imagem da Capa -->
                                    <Image Source="{Binding PathCover}" 
                                   Stretch="UniformToFill" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <!-- Gradiente Escuro no Rodapé -->
                                    <Border VerticalAlignment="Bottom" Height="80">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.0"/>
                                                <GradientStop Color="#CC131622" Offset="0.5"/>
                                                <GradientStop Color="#FF131622" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>

                                        <!-- Nome do Filme -->
                                        <TextBlock Text="{Binding Name}" 
                                           Foreground="{StaticResource TextPrimary}" 
                                           FontSize="13" 
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Margin="12,0,12,12" 
                                           VerticalAlignment="Bottom"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover Style -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardContainer" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                <Setter TargetName="CardContainer" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho / Barra de Pesquisa alinhada à esquerda -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBox Style="{StaticResource ModernSearchBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Digite o nome do filme para filtrar"
                     Width="380"
                     HorizontalAlignment="Left"/>
        </Grid>

        <!-- Grade de Resultados (Alinhada no canto superior esquerdo) -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Results}" HorizontalAlignment="Left" VerticalAlignment="Top">
                <!-- Layout WrapPanel Alinhado à Esquerda -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- Template do Card -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NetflixCardButtonStyle}" 
                                Command="{Binding DataContext.GoToContentHeroCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Name}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>