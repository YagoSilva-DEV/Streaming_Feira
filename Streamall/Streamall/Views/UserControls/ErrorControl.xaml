<UserControl x:Class="Streamall.Views.UserControls.ErrorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600">

    <!-- Fundo totalmente integrado com a Window (sem caixa flutuante) -->
    <Grid Background="#120E0F">
        <Grid.ColumnDefinitions>
            <!-- Faixa lateral de destaque -->
            <ColumnDefinition Width="8"/>
            <!-- Conteúdo principal -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Indicador visual lateral em vermelho -->
        <Rectangle Grid.Column="0" Fill="#FF4D4D"/>

        <!-- Conteúdo do Erro -->
        <Grid Grid.Column="1" Margin="32,28,32,24">
            <Grid.RowDefinitions>
                <!-- Cabeçalho (Ícone + Rótulo) -->
                <RowDefinition Height="Auto"/>
                <!-- Título do Erro -->
                <RowDefinition Height="Auto"/>
                <!-- Mensagem / Caminho do Ficheiro -->
                <RowDefinition Height="*"/>
                <!-- Rodapé (Botão de Ação) -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Cabeçalho com Ícone e Rótulo -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                <Viewbox Width="24" Height="24" Margin="0,0,10,0">
                    <Path Data="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2z M13,17h-2v-2h2v2z M13,13h-2V7h2v6z"
                          Fill="#FF4D4D"
                          Stretch="Uniform"/>
                </Viewbox>

                <TextBlock Text="OCORREU UM ERRO" 
                           FontFamily="{StaticResource Righteous}" 
                           FontSize="13" 
                           Foreground="#A0A0A0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 2. Tipo do Erro (Destaque Principal) -->
            <TextBlock Grid.Row="1" 
                       Text="{Binding ErrorType}" 
                       FontFamily="{StaticResource Righteous}" 
                       FontSize="20" 
                       Foreground="#FF4D4D"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <!-- 3. Detalhes do Erro / Caminho do Ficheiro -->
            <ScrollViewer Grid.Row="2" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,16">
                <TextBlock Text="{Binding ErrorMessage}" 
                           FontFamily="Segoe UI" 
                           FontSize="13" 
                           Foreground="#D0D0D0"
                           TextWrapping="Wrap" 
                           LineHeight="18"/>
            </ScrollViewer>

            <!-- 4. Botão de Retorno / Voltar para Login -->
            <Button Grid.Row="3" 
                    Content="Voltar" 
                    Command="{Binding CloseWindowCommand}"
                    Style="{StaticResource StyleButtonError}"/>
        </Grid>
    </Grid>
</UserControl>