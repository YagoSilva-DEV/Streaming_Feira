<UserControl x:Class="Streamall.Views.UserControls.InsertContentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Streamall.Views.UserControls"
             xmlns:helpers="clr-namespace:Streamall.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="850">
    <UserControl.Resources>
        <helpers:BitMapHelper x:Key="ImagePathConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="0,0,0,20" Padding="0,0,0,16" BorderBrush="{StaticResource BorderColorEditModalBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="STREAMALL STUDIO" Foreground="{StaticResource TextSecondaryLoginBrush}" FontSize="13" FontFamily="{StaticResource Righteous}" FontWeight="Bold"/>
                            <Border Background="#1F3D2B" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="• CADASTRO" Foreground="#4EED89" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Novo Conteúdo" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryLoginBrush}" Margin="0,4,0,0" FontFamily="{StaticResource Righteous}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="280"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Capa do Conteúdo" Style="{StaticResource StyleFieldLabelEditModal}" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Border Grid.Row="1" Style="{StaticResource ImageContainerStyle}" VerticalAlignment="Stretch" MinHeight="260">
                            <Grid>
                                <Image Source="{Binding PathCover, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                    <TextBlock Text="{Binding FileMessage, FallbackValue='Nenhuma imagem selecionada'}" 
                                               Foreground="{StaticResource TextSecondaryLoginBrush}" 
                                               FontSize="11" 
                                               TextAlignment="Center" 
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Grid.Row="2" Content="Carregar Capa" 
                                Style="{StaticResource StyleSecondaryButtonEditModal}" 
                                Height="38" 
                                Margin="0,14,0,0" 
                                Command="{Binding OpenImageFileDialogCommand}"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="20" VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Informações Gerais" Style="{StaticResource StyleFieldLabelEditModal}" FontSize="14" FontWeight="Bold" Margin="0,0,0,16"/>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Nome do Conteúdo" Style="{StaticResource StyleFieldLabelEditModal}" Margin="0,0,0,6"/>
                            <TextBox Height="40" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleTextBoxEditModal}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tipo de Conteúdo" Style="{StaticResource StyleFieldLabelEditModal}" Margin="0,0,0,6"/>
                                <ComboBox SelectedItem="{Binding ContentType}" ItemsSource="{Binding ContentTypes}" Style="{StaticResource StyleComboBoxEditModal}" Height="40"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gênero" Style="{StaticResource StyleFieldLabelEditModal}" Margin="0,0,0,6"/>
                                <ComboBox SelectedItem="{Binding GenreDTO}" SelectedValuePath="Id" DisplayMemberPath="Name" ItemsSource="{Binding Genres}" Style="{StaticResource StyleComboBoxEditModal}" Height="40"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cineasta / Diretor" Style="{StaticResource StyleFieldLabelEditModal}" Margin="0,0,0,6"/>
                                <ComboBox SelectedItem="{Binding FilmMaker}" SelectedValuePath="Id" DisplayMemberPath="Name" ItemsSource="{Binding FilmMakers}" Style="{StaticResource StyleComboBoxEditModal}" Height="40"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data de Lançamento" Style="{StaticResource StyleFieldLabelEditModal}" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding ReleaseDate}" Height="40" Background="{StaticResource InputBackgroundEditModalBrush}" IsTodayHighlighted="True"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Sinopse" Style="{StaticResource StyleFieldLabelEditModal}" Margin="0,0,0,6"/>
                            <TextBox Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding Synopsis, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleTextBoxEditModal}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBlock
                           Text="{Binding ErrorMessage}" 
                           Style="{StaticResource StyleTextBlockError}" FontSize="20"/>

                    <TextBlock
                           Text="{Binding SuccessMessage}" 
                           Style="{StaticResource StyleTextBlockSuccess}" FontSize="20"/>
                </Grid>
                <Button Grid.Column="1"
                        Content="CADASTRAR"
                        Command="{Binding InsertCommand}"
                        Style="{StaticResource StylePrimaryButtonEditModal}"
                        Height="46">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>