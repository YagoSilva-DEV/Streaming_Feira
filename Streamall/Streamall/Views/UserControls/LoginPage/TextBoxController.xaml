<UserControl x:Class="Streamall.Views.UserControls.LoginPage.TextBoxController"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Streamall.Views.UserControls.LoginPage"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="350">
    <Grid>
        <TextBox x:Name="txtInput" Style="{StaticResource StyleTextBoxLogin}" TextChanged="txtInput_TextChanged" Height="35"/>
        <TextBlock x:Name="tbText" Style="{StaticResource StyleTextBlockLogin}" Text="{Binding Placeholder}" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
