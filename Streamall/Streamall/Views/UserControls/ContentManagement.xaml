<UserControl x:Class="Streamall.Views.UserControls.ContentManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Streamall.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- Grid ocupando todo o espaço disponível -->
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho Principal -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Gerenciar Catálogo" Style="{StaticResource StyleTextBlockTopAdmHome}"/>
                <TextBlock Text="Visualize, edite ou remova os filmes da plataforma." Style="{StaticResource StyleTextBlockDescriptionTopAdmHome}"/>
            </StackPanel>
        </Grid>

        <!-- Lista de Mídias -->
        <ListView Grid.Row="1" 
                  ItemsSource="{Binding Contents}" 
                  ItemContainerStyle="{StaticResource CleanListViewItemStyle}"
                  ScrollViewer.CanContentScroll="False" 
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Background="Transparent" 
                  BorderThickness="0">

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Width="205" Height="340" 
                            Background="{StaticResource BackgroundColorLoginBrush}" 
                            BorderBrush="{StaticResource BorderColorLoginBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Imagem da Capa (Com suporte a Fallback e limitação estrita de recorte) -->
                            <Grid Grid.Row="0" ClipToBounds="True">
                                <Image Source="{Binding PathCover, TargetNullValue='/Streamall;component/Assets/placeholder.png', FallbackValue='/Streamall;component/Assets/placeholder.png'}" 
                                       Stretch="UniformToFill" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>

                                <!-- Sombras nos cantos para dar acabamento escuro -->
                                <Border Background="#10000000"/>
                            </Grid>

                            <!-- Barra de Ações com Botões SVG -->
                            <Border Grid.Row="1" Background="#121318" Padding="8,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Botão Editar (Tom Laranja-Âmbar) -->
                                    <Button Style="{StaticResource CardActionButtonStyle}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Editar filme"
                                            Margin="0,0,6,0">
                                        <Path Data="M14.06,9.02L14.98,9.94L5.92,19H5V18.08L14.06,9.02M17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18.17,3.09 17.92,3 17.66,3M14.06,6.19L3,17.25V21H6.75L17.81,9.94L14.06,6.19Z" 
                                              Fill="#FB923C" 
                                              Width="18" 
                                              Height="18" 
                                              Stretch="Uniform"/>
                                    </Button>

                                    <!-- Botão Apagar (Vermelho) -->
                                    <Button Style="{StaticResource CardActionButtonStyle}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Excluir filme">
                                        <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" 
                                              Fill="#E53935" 
                                              Width="18" 
                                              Height="18" 
                                              Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>