<UserControl x:Class="Streamall.Views.UserControls.ContentManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Streamall.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <ListView ItemsSource="{Binding Contents}" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{StaticResource BackgroundColorLoginBrush}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource BackgroundColorLoginBrush}" CornerRadius="6" BorderBrush="{StaticResource BorderColorLoginBrush}" BorderThickness="1">
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="250" Height="250">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="9*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Image Source="{Binding PathCover}" Stretch="UniformToFill" Opacity="0.8" Grid.RowSpan="2" ClipToBounds="True"/>
                            <TextBlock Grid.Row="2" Text="{Binding Name}" Style="{StaticResource StyleTextBlockContentName}" Background="{StaticResource BackgroundColorLoginBrush}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
