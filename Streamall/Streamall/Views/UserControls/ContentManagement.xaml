<UserControl x:Class="Streamall.Views.UserControls.ContentManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Streamall.Views.UserControls"
             mc:Ignorable="d" 
             xmlns:hepers="clr-namespace:Streamall.Helpers"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{StaticResource BackgroundColorLoginBrush}">

    <UserControl.Resources>
        <hepers:BitMapHelper x:Key="ImageConverter"/>

        <!-- Estilo Moderno para os Botões de Ação do Card -->
        <Style x:Key="ModernCardActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1A202C"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2D3748"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#4A5568"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1A202C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Editar Específico (Hover Âmbar/Laranja) -->
        <Style x:Key="EditCardActionButton" TargetType="Button" BasedOn="{StaticResource ModernCardActionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C1D11"/>
                    <Setter Property="BorderBrush" Value="#7C2D12"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão Excluir Específico (Hover Vermelho) -->
        <Style x:Key="DeleteCardActionButton" TargetType="Button" BasedOn="{StaticResource ModernCardActionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D1214"/>
                    <Setter Property="BorderBrush" Value="#7F1D1D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Grid ocupando todo o espaço disponível -->
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho Principal -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Gerenciar Catálogo" Style="{StaticResource StyleTextBlockTopAdmHome}"/>
                <TextBlock Text="Visualize, edite ou remova os filmes da plataforma." Style="{StaticResource StyleTextBlockDescriptionTopAdmHome}"/>
            </StackPanel>
        </Grid>

        <!-- Lista de Mídias -->
        <ListView Grid.Row="1" 
                  ItemsSource="{Binding Contents}" 
                  ItemContainerStyle="{StaticResource CleanListViewItemStyle}"
                  ScrollViewer.CanContentScroll="False" 
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Background="Transparent" 
                  BorderThickness="0"
                  HorizontalAlignment="Center">

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Width="220" Height="370" 
                            Background="{StaticResource BackgroundColorLoginBrush}" 
                            BorderBrush="{StaticResource BorderColorLoginBrush}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            ClipToBounds="True"
                            ToolTip="{Binding Name}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Imagem da Capa -->
                            <Grid Grid.Row="0" ClipToBounds="True">
                                <Image Source="{Binding PathCover, Converter={StaticResource ImageConverter}}" 
                                       Stretch="UniformToFill" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>

                                <!-- Sombras nos cantos para dar acabamento escuro -->
                                <Border Background="#10000000"/>
                            </Grid>

                            <!-- Barra de Ações com Botões Estilizados e Título -->
                            <Border Grid.Row="1" Background="#0F111A" Padding="10,8" BorderBrush="#1E2330" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Título/Nome do Conteúdo (Suporta Name ou Title) -->
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding Name}" 
                                               Foreground="{StaticResource TextPrimaryLoginBrush}" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               VerticalAlignment="Center" 
                                               TextTrimming="CharacterEllipsis" 
                                               Margin="0,0,6,0"/>

                                    <!-- Botões de Ação -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- Botão Editar -->
                                        <Button Style="{StaticResource EditCardActionButton}"
                                                Command="{Binding DataContext.EditContentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Editar filme"
                                                Margin="0,0,6,0">
                                            <Path Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25Z M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z" 
                                                  Fill="#F97316" 
                                                  Width="13" 
                                                  Height="13" 
                                                  Stretch="Uniform"/>
                                        </Button>

                                        <!-- Botão Apagar -->
                                        <Button Style="{StaticResource DeleteCardActionButton}"
                                                Command="{Binding DataContext.RemoveContentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Excluir filme">
                                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" 
                                                  Fill="#EF4444" 
                                                  Width="13" 
                                                  Height="13" 
                                                  Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>