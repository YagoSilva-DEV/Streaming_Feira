<UserControl x:Class="Streamall.Views.UserControls.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Streamall.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">
    <Grid Background="{StaticResource SurfaceColorLoginBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--<TextBox Grid.Column="0" Background="Transparent" Foreground="White" BorderThickness="0" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Center"> Nivel assinatura </TextBox>-->
        <TextBlock Grid.Column="1" Style="{StaticResource StyleTextBlockLogoLogin}" FontSize="60"  VerticalAlignment="Center" > Streamall</TextBlock>
        
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <TextBlock  Foreground="White" Margin="5"  VerticalAlignment="Center"> foto perfil</TextBlock>
            <TextBlock  Foreground="White" Margin="5"  VerticalAlignment="Center" Text="{Binding UserName, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </StackPanel>
    </Grid>
</UserControl>
