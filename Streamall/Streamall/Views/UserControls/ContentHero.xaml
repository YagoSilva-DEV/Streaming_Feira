<UserControl x:Class="Streamall.Views.UserControls.ContentHero"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Streamall.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource SurfaceColorLoginBrush}">
       <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        
            <Image Grid.Row="0" Source="https://via.placeholder.com/800x400" Stretch="UniformToFill"/>
        <Path/>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Margin="20" >
                <TextBlock Text="Hero Title" FontSize="24" Foreground="White" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Text="This is a description for the hero section. It can be a brief summary or call to action."
                FontSize="16" Foreground="White" Margin="0,10,0,0"/>

                <StackPanel Orientation="Horizontal"  Margin="0,10,0,0">
                    <TextBlock Text="ano" Foreground="White" Margin="0,10,20,0"/>
                    <TextBlock Text="•" Foreground="White" Margin="0,10,20,0"/>
                    <TextBlock Text="genero" Foreground="White" Margin="0,10,20,0"/>
                    <TextBlock Text="•" Foreground="White" Margin="0,10,20,0"/>
                    <TextBlock Text="duração" Foreground="White" Margin="0,10,20,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Assistir" Width="120" Height="30" Margin="0,20,0,0" Foreground="White" Style="{StaticResource StyleButtonSideBar}" Background="DarkRed" BorderBrush="Red" Tag="MediumSeaGreen"  />
                    <Button Width="120" Height="40" Margin="0,20,0,0" Style="{StaticResource StyleButtonSideBar}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
        
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Path Style="{StaticResource IconsGlobalConfigs}"
                                      Data="{StaticResource IconStar}"
                                />
                            </Viewbox>
                            
                            <TextBlock Text="Favoritos" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Mais como este" Foreground="White"/>
            <UserControl Grid.Row="1"></UserControl>
        </Grid>
    </Grid>
</UserControl>
